# Copy this file to .env and fill it in.

# The first admin account, made the first time the backend starts. More
# accounts, and new passwords, are then set on the Staff page, and these two
# are not used again.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Where the data is kept. Leave this out to use a SQLite file (seedcode.db)
# in this folder. For MySQL or PostgreSQL, install the driver and set e.g.
#   DATABASE_URL=mysql+pymysql://user:password@localhost/seedcode
#   DATABASE_URL=postgresql+psycopg://user:password@localhost/seedcode
# DATABASE_URL=

# HOST=127.0.0.1
# PORT=8010
# RELOAD=true

# The interactive API pages at /api/docs. Handy while developing; leave
# them off on a server.
# DOCS=true

# To run everything in Docker instead, see ../.env.example.
