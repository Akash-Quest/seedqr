# For Docker. Copy this file to .env and fill it in. Keep it private:
#   chmod 600 .env
# (Running without Docker uses backend/.env instead.)

# The address farmers' phones will open, printed inside each QR code.
# Required, and must start with https:// for a real site. A printed label
# cannot be changed later, so get this right before printing.
#   PUBLIC_URL=https://seeds.example.org
# Changing it needs a rebuild: docker compose up -d --build
PUBLIC_URL=

# Password for the database that Docker creates. Required. Use letters and
# digits only, since it becomes part of the database address. Make it long:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The first admin account, made the first time the site starts (password at
# least 8 characters). More accounts, and new passwords, are then set on the
# Staff page. Once you have signed in, remove these two lines.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Where the site is reached on this computer. By default only this computer
# can reach it, and nginx passes the world's requests on. To try it from a
# phone on the same Wi-Fi instead, set BIND=0.0.0.0 and this computer's
# address on the Wi-Fi (e.g. 192.168.1.20), and set PUBLIC_URL to
# http://localhost:8010.
# PORT=8010
# BIND=127.0.0.1
# LAN_ADDRESS=

# The interactive API pages at /api/docs. Leave off on a real site.
# DOCS=false
