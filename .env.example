# For Docker. Copy this file to .env and fill it in.
# (Running without Docker uses backend/.env instead.)

# The first admin account, made the first time the site starts. Both
# required; the password needs at least 8 characters. More accounts, and new
# passwords, are then set on the Staff page, and these two are not used again.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Password for the database that Docker creates. Required. Use letters and
# digits only, since it becomes part of the database address.
POSTGRES_PASSWORD=

# The address farmers' phones will open, printed inside each QR code, e.g.
#   PUBLIC_URL=https://seeds.example.org
# Changing it needs a rebuild: docker compose up -d --build
# PUBLIC_URL=

# Only for trying the app on this computer at http://localhost:8010: this
# computer's address on the Wi-Fi (e.g. 192.168.1.20), so that QR codes open
# on a phone. Not needed once PUBLIC_URL is set.
# LAN_ADDRESS=

# The port the site is reached on.
# PORT=8010
